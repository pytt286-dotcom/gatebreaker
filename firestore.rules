rules_version = '2';
// ============================================================================
// Gatebreaker Fitness — Firestore security rules (v3)
// Enforced on Google's servers: no app code (or modified app code) can bypass them.
//  * The coach (one VERIFIED email) can read and write everything.
//  * A client can only read/write their OWN channel: clients/{theirUid}/...
//    and read their own plan. They can never see or touch any other client.
//  * New clients need the coach's invite code to join.
//  * Only known collections are allowed and sizes are capped, so nobody can
//    stuff the database with junk or oversized files.
// The coach email below must be lower-case.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isCoach() {
      return signedIn()
        && request.auth.token.email == 'COACH_EMAIL_HERE'
        && request.auth.token.email_verified == true;
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isMember(uid) {
      return isSelf(uid) && exists(/databases/$(database)/documents/clients/$(uid));
    }
    function data() { return request.resource.data; }
    function inviteOk() {
      return data().invite is string
        && exists(/databases/$(database)/documents/coachPrivate/settings)
        && data().invite.upper()
           == get(/databases/$(database)/documents/coachPrivate/settings).data.inviteCode.upper();
    }
    function profileOk() {
      return data().name is string && data().name.size() > 0 && data().name.size() <= 60;
    }
    function photoOk() {
      return data().data is string && data().data.size() < 1000000
        && data().data.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$');
    }
    // side = 'coach' or 'client' (who is writing)
    function msgUpdateOk(side) {
      let changed = data().diff(resource.data).affectedKeys();
      let other = side == 'coach' ? 'client' : 'coach';
      let rxOk = !('rx' in data()) || (data().rx is map && data().rx.keys().hasOnly(['coach', 'client'])
        && data().rx.get(other, null) == resource.data.get('rx', {}).get(other, null)
        && (data().rx.get(side, '') is string && data().rx.get(side, '').size() <= 8));
      return rxOk && (
        // reacting (either side, only its own reaction)
        changed.hasOnly(['rx'])
        // editing your own text
        || (resource.data.from == side && changed.hasOnly(['text', 'edited', 'rx'])
            && data().text is string && data().text.size() <= 4000 && data().edited is number));
    }
    function noteOk() {
      return (!('title' in data()) || (data().title is string && data().title.size() <= 200))
        && (!('body' in data()) || (data().body is string && data().body.size() <= 20000));
    }

    // Coach's public card (name, gym) — any signed-in member can read it.
    match /coach/{doc} {
      allow read: if signedIn();
      allow write: if isCoach();
    }
    // Invite code, quick replies — coach only.
    match /coachPrivate/{doc} {
      allow read, write: if isCoach();
    }
    // Coach's private notes about each client — coach only.
    match /coachNotes/{uid} {
      allow read, write: if isCoach();
    }
    // Tracking plan per client (check-in basis, targets) — set by coach, read by that client.
    match /plans/{uid} {
      allow read: if isCoach() || isSelf(uid);
      allow write: if isCoach();
    }

    // Each client's private channel.
    match /clients/{uid} {
      allow read: if isCoach() || isSelf(uid);
      allow create: if isCoach() || (isSelf(uid) && inviteOk() && profileOk() && data().consentAt is number);
      allow update: if isCoach()
        || (isSelf(uid) && profileOk() && data().invite == resource.data.invite);
      allow delete: if isCoach();

      // Chat: each side can only post as itself. The author can edit the text of
      // their own message; the other side can only add/remove their own reaction.
      match /messages/{id} {
        allow read: if isCoach() || isSelf(uid);
        allow create: if data().text is string
          && data().text.size() <= 4000
          && data().keys().hasOnly(['from', 'text', 'at', 'ph', 'broadcast', 're'])
          && (!('re' in data()) || (data().re is map && data().re.keys().hasOnly(['id', 'from', 'text', 'ph'])
              && data().re.get('text', '') is string && data().re.get('text', '').size() <= 200))
          && ((isCoach() && data().from == 'coach')
              || (isMember(uid) && data().from == 'client'));
        allow update: if (isCoach() || isMember(uid)) && msgUpdateOk(isCoach() ? 'coach' : 'client');
        allow delete: if (isCoach() && resource.data.from == 'coach')
          || (isSelf(uid) && resource.data.from == 'client');
      }
      // Photos: only real images, under 1 MB.
      match /photos/{id} {
        allow read: if isCoach() || isSelf(uid);
        allow create, update: if (isCoach() || isMember(uid)) && photoOk();
        allow delete: if isCoach() || isMember(uid);
      }
      // Shared notes.
      match /notes/{id} {
        allow read: if isCoach() || isSelf(uid);
        allow create, update: if (isCoach() || isMember(uid)) && noteOk();
        allow delete: if isCoach() || isMember(uid);
      }
      // Read receipts: each side writes only its own; 'chat' (last message) by both.
      match /status/{side} {
        allow read: if isCoach() || isSelf(uid);
        allow write: if isCoach() || (isMember(uid) && side in ['client', 'chat']);
      }
      // Food days, summaries, progress, "my foods".
      match /{sub}/{doc} {
        allow read: if sub in ['days', 'summary', 'progress', 'meta'] && (isCoach() || isSelf(uid));
        allow write: if sub in ['days', 'summary', 'progress', 'meta'] && (isCoach() || isMember(uid));
      }
    }

    // "Something happened" markers for the push-notification job (notifier/).
    // Anyone in the system can drop a marker about their OWN channel; nobody can
    // read them (the job uses a server key). The job looks up the real message
    // itself, so a marker can't carry text that ends up in a notification.
    match /pushq/{id} {
      allow create: if signedIn()
        && data().keys().hasOnly(['uid', 'kind', 'from', 'at', 'ref', 'date'])
        && data().uid is string && data().at is number
        && data().kind in ['msg', 'note', 'est-req', 'est-done', 'plan']
        && (!('ref' in data()) || (data().ref is string && data().ref.size() <= 64))
        && (!('date' in data()) || (data().date is string && data().date.size() == 10))
        && ((isCoach() && data().from == 'coach') || (isMember(data().uid) && data().from == 'client'));
      allow read, update, delete: if false;
    }

    // Collection-group reads for the coach's roster.
    match /{path=**}/status/{doc} { allow read: if isCoach(); }
    match /{path=**}/summary/{doc} { allow read: if isCoach(); }
    match /{path=**}/progress/{doc} { allow read: if isCoach(); }
  }
}
